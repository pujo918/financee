<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <!-- Top Bar: Title & Voice Mic Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widgetSmallAvatar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_avatar_bg"
            android:padding="2dp"
            android:src="@drawable/avatar_luffy"
            android:scaleType="centerInside"
            android:contentDescription="Avatar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FINANCE TRACKER"
            android:textColor="#94a3b8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <!-- 1-Tap Mic Action Button -->
        <LinearLayout
            android:id="@+id/widgetMicButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/widget_mic_bg"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_mic_widget"
                android:contentDescription="Mic Icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Bicara"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Balance Display -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Saldo Bulan Ini"
        android:textColor="#cbd5e1"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widgetBalanceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rp 0"
        android:textColor="#f8fafc"
        android:textSize="21sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <!-- Bottom Stat Row: Income & Expense -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widgetIncomeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+Rp 0"
            android:textColor="#4ade80"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widgetExpenseText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-Rp 0"
            android:textColor="#f87171"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:gravity="end"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
