<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetLargeRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= LAYER 0: CARD GRADIENT & BORDER ================= -->
    <ImageView
        android:id="@+id/widgetLargeBgOnePiece"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_onepiece"
        android:contentDescription="One Piece Background" />

    <ImageView
        android:id="@+id/widgetLargeBgNaruto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg_naruto"
        android:visibility="gone"
        android:contentDescription="Naruto Background" />

    <!-- ================= LAYER 1: WATERMARK THEME ARTWORK ================= -->
    <ImageView
        android:id="@+id/widgetLargeArtOnePiece"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end|bottom"
        android:src="@drawable/widget_art_onepiece"
        android:scaleType="fitEnd"
        android:alpha="0.26"
        android:contentDescription="One Piece Watermark" />

    <ImageView
        android:id="@+id/widgetLargeArtNaruto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end|bottom"
        android:src="@drawable/widget_art_naruto"
        android:scaleType="fitEnd"
        android:alpha="0.26"
        android:visibility="gone"
        android:contentDescription="Naruto Watermark" />

    <!-- ================= LAYER 2: INTERACTIVE UI CONTENT ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp">

        <!-- Header: Avatar, App Title, Theme Badge & Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="6dp">

            <!-- Avatar Container -->
            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp">

                <ImageView
                    android:id="@+id/widgetAvatarLuffy"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/widget_avatar_bg_onepiece"
                    android:padding="2dp"
                    android:src="@drawable/avatar_luffy"
                    android:scaleType="fitCenter"
                    android:contentDescription="Avatar One Piece" />

                <ImageView
                    android:id="@+id/widgetAvatarNaruto"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/widget_avatar_bg_naruto"
                    android:padding="2dp"
                    android:src="@drawable/avatar_naruto"
                    android:scaleType="fitCenter"
                    android:visibility="gone"
                    android:contentDescription="Avatar Naruto" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catatan Keuangan"
                    android:textColor="#ffffff"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ketuk Mic &amp; Bicara"
                    android:textColor="#94a3b8"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Theme Badge -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/widgetThemeBadgeOnePiece"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_onepiece"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="ONE PIECE"
                    android:textColor="#38bdf8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widgetThemeBadgeNaruto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_naruto"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="NARUTO"
                    android:textColor="#f97316"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Main Body: 2 Columns with Optimized Space Utilization -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp">

            <!-- Column 1: Voice Button & Audio Feedback Wave -->
            <LinearLayout
                android:id="@+id/widgetLargeMicButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.05"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <!-- Mic Circle with Soundwaves -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_soundwave"
                        android:contentDescription="Soundwave Left" />

                    <FrameLayout
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="7dp">

                        <ImageView
                            android:id="@+id/widgetLargeMicGlowCyan"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/widget_glow_mic_cyan"
                            android:padding="13dp"
                            android:src="@drawable/ic_mic_widget"
                            android:contentDescription="Mic Cyan" />

                        <ImageView
                            android:id="@+id/widgetLargeMicGlowOrange"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/widget_glow_mic_orange"
                            android:padding="13dp"
                            android:src="@drawable/ic_mic_widget"
                            android:visibility="gone"
                            android:contentDescription="Mic Orange" />
                    </FrameLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_soundwave"
                        android:contentDescription="Soundwave Right" />
                </LinearLayout>

                <!-- Quoted Transcript Text -->
                <TextView
                    android:id="@+id/widgetLargeTranscriptText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="&quot;Ketuk mic untuk bicara&quot;"
                    android:textColor="#e2e8f0"
                    android:textSize="11sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- Vertical Divider -->
            <ImageView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="#334155"
                android:contentDescription="Divider" />

            <!-- Column 2: Transaction Details & Action Buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Nominal Header Row -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nominal Transaksi"
                    android:textColor="#94a3b8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widgetLargeNominalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Rp 0"
                    android:textColor="#34d399"
                    android:textSize="18.5sp"
                    android:textStyle="bold" />

                <!-- Category & Type in Structured Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kategori"
                            android:textColor="#94a3b8"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/widgetLargeCategoryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Makanan"
                            android:textColor="#f8fafc"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tipe"
                            android:textColor="#94a3b8"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/widgetLargeTypeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Pengeluaran"
                            android:textColor="#f87171"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Action Buttons: [Edit] and [Simpan] -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:id="@+id/widgetLargeEditButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/widget_btn_edit"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:src="@drawable/ic_edit_small"
                            android:contentDescription="Edit" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Edit"
                            android:textColor="#cbd5e1"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/widgetLargeSaveButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.25"
                        android:layout_marginStart="6dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/widget_btn_save"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:src="@drawable/ic_check_small"
                            android:contentDescription="Simpan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Simpan"
                            android:textColor="#ffffff"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
