<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogOutsideOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#77000000"
    android:padding="16dp">

    <!-- Centered Floating Dialog Card -->
    <LinearLayout
        android:id="@+id/dialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/widget_bg_onepiece"
        android:clickable="true"
        android:focusable="true">

        <!-- Top Header: Avatar, Mode/Status, Close Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/dialogAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/widget_avatar_bg_onepiece"
                android:padding="2dp"
                android:src="@drawable/avatar_luffy"
                android:scaleType="fitCenter"
                android:contentDescription="Avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dialogTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catatan Keuangan Cepat"
                    android:textColor="#f8fafc"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialogStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mendengarkan... Silakan bicara"
                    android:textColor="#38bdf8"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dialogCloseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Tutup"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ================= MODE 1: VOICE INPUT SECTION ================= -->
        <LinearLayout
            android:id="@+id/dialogVoiceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <!-- Left: Mic button + Transcript -->
            <LinearLayout
                android:id="@+id/dialogMicButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_soundwave"
                        android:contentDescription="Soundwave Left" />

                    <ImageView
                        android:id="@+id/dialogMicGlow"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/widget_glow_mic_cyan"
                        android:padding="13dp"
                        android:src="@drawable/ic_mic_widget"
                        android:contentDescription="Mic" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_soundwave"
                        android:contentDescription="Soundwave Right" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dialogTranscriptText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="&quot;Bicara transaksi Anda...&quot;"
                    android:textColor="#f1f5f9"
                    android:textSize="12sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- Divider -->
            <ImageView
                android:layout_width="1dp"
                android:layout_height="115dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:background="#27354f"
                android:contentDescription="Divider" />

            <!-- Right: Parsed details & Action Buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.25"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nominal"
                    android:textColor="#94a3b8"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/dialogNominalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Rp 0"
                    android:textColor="#34d399"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kategori"
                            android:textColor="#94a3b8"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/dialogCategoryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Makanan"
                            android:textColor="#f8fafc"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tipe"
                            android:textColor="#94a3b8"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/dialogTypeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Pengeluaran"
                            android:textColor="#f87171"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Actions: Edit & Simpan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/dialogEditButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/widget_btn_edit"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_edit_small"
                            android:contentDescription="Edit" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Edit"
                            android:textColor="#cbd5e1"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dialogSaveButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:layout_marginStart="8dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/widget_btn_save"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_check_small"
                            android:contentDescription="Simpan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Simpan"
                            android:textColor="#ffffff"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= MODE 2: INLINE EDIT SECTION ================= -->
        <LinearLayout
            android:id="@+id/dialogEditSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Nominal Amount Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nominal Transaksi (Rp)"
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editAmountInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/dialog_input_bg"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="25000"
                android:textColor="#34d399"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Quick Increment Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/chipAdd5k"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/dialog_chip_unselected"
                    android:gravity="center"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="+5rb"
                    android:textColor="#94a3b8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipAdd10k"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/dialog_chip_unselected"
                    android:gravity="center"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="+10rb"
                    android:textColor="#94a3b8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipAdd25k"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/dialog_chip_unselected"
                    android:gravity="center"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="+25rb"
                    android:textColor="#94a3b8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipAdd50k"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/dialog_chip_unselected"
                    android:gravity="center"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="+50rb"
                    android:textColor="#94a3b8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipResetAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:background="@drawable/dialog_chip_unselected"
                    android:gravity="center"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="0"
                    android:textColor="#f87171"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Category Selector (2 Rows of Chips) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pilih Kategori"
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/catFood"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/dialog_chip_selected"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Makanan"
                    android:textColor="#ffffff"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/catTransport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/dialog_chip_unselected"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Transport"
                    android:textColor="#cbd5e1"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/catBills"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/dialog_chip_unselected"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Tagihan"
                    android:textColor="#cbd5e1"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/catShopping"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/dialog_chip_unselected"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Belanja"
                    android:textColor="#cbd5e1"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/catEntertainment"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/dialog_chip_unselected"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Hiburan"
                    android:textColor="#cbd5e1"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/catSalary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/dialog_chip_unselected"
                    android:gravity="center"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Pemasukan"
                    android:textColor="#cbd5e1"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Note / Description Input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Keterangan / Catatan"
                android:textColor="#94a3b8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editNoteInput"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/dialog_input_bg"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Beli bakso &amp; es teh"
                android:textColor="#f8fafc"
                android:textSize="12sp" />

            <!-- Action Buttons for Edit Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/editBackToVoiceButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/widget_btn_edit"
                    android:gravity="center"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="Mode Suara"
                    android:textColor="#cbd5e1"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/editSaveButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/widget_btn_save"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_check_small"
                        android:contentDescription="Simpan" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Simpan Catatan"
                        android:textColor="#ffffff"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
