<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialogOutsideOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:padding="20dp">

    <!-- Centered Floating Dialog Card -->
    <LinearLayout
        android:id="@+id/dialogCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/widget_bg_4x2"
        android:clickable="true"
        android:focusable="true">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp">

            <ImageView
                android:id="@+id/dialogAvatar"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/widget_avatar_bg"
                android:padding="2dp"
                android:src="@drawable/avatar_luffy"
                android:scaleType="centerInside"
                android:contentDescription="Avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catatan Suara Langsung"
                    android:textColor="#f8fafc"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/dialogStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mendengarkan... Silakan bicara"
                    android:textColor="#38bdf8"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/dialogCloseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="Batal"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Body: 2 Columns -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <!-- Left: Mic button + Transcript -->
            <LinearLayout
                android:id="@+id/dialogMicButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/dialogSoundwaveLeft"
                        android:layout_width="18dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_soundwave"
                        android:contentDescription="Soundwave" />

                    <ImageView
                        android:id="@+id/dialogMicGlow"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/widget_glow_mic_cyan"
                        android:padding="13dp"
                        android:src="@drawable/ic_mic_widget"
                        android:contentDescription="Mic" />

                    <ImageView
                        android:id="@+id/dialogSoundwaveRight"
                        android:layout_width="18dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_soundwave"
                        android:contentDescription="Soundwave" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dialogTranscriptText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxLines="3"
                    android:text="&quot;Bicara transaksi Anda...&quot;"
                    android:textColor="#f1f5f9"
                    android:textSize="12sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="110dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:background="#27354f" />

            <!-- Right: Parsed details & buttons -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nominal"
                    android:textColor="#94a3b8"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/dialogNominalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Rp 0"
                    android:textColor="#34d399"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kategori"
                            android:textColor="#94a3b8"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/dialogCategoryText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="-"
                            android:textColor="#f8fafc"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tipe"
                            android:textColor="#94a3b8"
                            android:textSize="9.5sp" />

                        <TextView
                            android:id="@+id/dialogTypeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:text="Pengeluaran"
                            android:textColor="#f87171"
                            android:textSize="11.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Actions: Edit & Simpan -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:id="@+id/dialogEditButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/widget_btn_edit"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_edit_small"
                            android:contentDescription="Edit" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Edit"
                            android:textColor="#cbd5e1"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/dialogSaveButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.3"
                        android:layout_marginStart="8dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:background="@drawable/widget_btn_save"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_check_small"
                            android:contentDescription="Simpan" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Simpan"
                            android:textColor="#ffffff"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>